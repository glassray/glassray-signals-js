{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "customConditions": []
  },
  "include": ["src"]
}
